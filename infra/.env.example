# Copy to .env (never commit .env). Values below are development defaults only.

POSTGRES_DB=workpulse
POSTGRES_USER=workpulse
POSTGRES_PASSWORD=workpulse_dev_password
# Host port for the Compose PostgreSQL. 55432 avoids clashing with a locally installed PostgreSQL (5432)
# or other projects' database containers.
POSTGRES_PORT=55432

REDIS_PASSWORD=workpulse_dev_redis
REDIS_PORT=6379

RABBITMQ_USER=workpulse
RABBITMQ_PASSWORD=workpulse_dev_rabbit
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Backend (profile "app")
BACKEND_PORT=8081
# At least 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=change-me-in-production-this-must-be-at-least-32-bytes-long
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
DEMO_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@workpulse.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026

# Web portal (profile "app")
WEB_PORT=8080
